# MSH API OAuth (client_credentials grant), server-side only, never sent to the browser.
MSH_CLIENT_ID=
MSH_CLIENT_SECRET=
MSH_AUTH_URL=https://monitor-your-satellites.eu.auth0.com/oauth/token
MSH_API_BASE_URL=https://api.monitor-space-hazards.service.gov.uk
MSH_AUDIENCE=monitor-your-satellites.service.gov.uk/api

# Feature flag. When true, live-capable section pages try the live MSH API. If it's
# false, or a live call errors, the affected figures show "No live data source connected"
# / "No data available", never a placeholder number.
USE_LIVE_MSH=true

# Space Weather is sourced from NOAA SWPC's free public alerts feed, not MSH, no
# credentials needed. Defaults to true; set to "false" to show the "not connected" state
# instead (e.g. a deterministic demo).
USE_LIVE_SPACE_WEATHER=true

# Mapbox GL JS public token for the Re-Entry Map (app/views/re-entry/map.html and its
# Presentation Mode slide). Public/browser-facing by design, Mapbox scopes it by URL in
# the Mapbox account rather than keeping it secret. Without this set, the map shows a
# "not configured" message instead of a broken map.
MAPBOX_ACCESS_TOKEN=

# Required by the GOV.UK Prototype Kit itself whenever USE_AUTH is true (the default).
# Without this set, every page shows a "no password configured" error instead of the
# dashboard, so hosting platforms need it set explicitly, it won't work unset.
PASSWORD=
