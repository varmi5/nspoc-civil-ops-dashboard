# MSH API OAuth (client_credentials grant) — server-side only, never sent to the browser.
MSH_CLIENT_ID=
MSH_CLIENT_SECRET=
MSH_AUTH_URL=https://monitor-your-satellites.eu.auth0.com/oauth/token
MSH_API_BASE_URL=https://api.monitor-space-hazards.service.gov.uk
MSH_AUDIENCE=monitor-your-satellites.service.gov.uk/api

# Feature flag — when true, section pages try the live MSH API first and fall back to
# fixtures automatically (with the "Sample data" badge) only if a live call errors.
USE_LIVE_MSH=true
