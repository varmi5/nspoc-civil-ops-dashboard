{#
Renders the chart object from app/lib/charts/line-chart.js: up to two lines sharing a
chart but not a scale, each independently scaled to its own max, so the legend states
each line's own range (0 to its max) rather than implying a shared one. Points carry
native <title> tooltips.

countLabel/alertLabel default to re-entry's wording; pass different labels when "alerts"
isn't right (e.g. Collision & Fragmentation's second line is a probability-threshold
count). alertShortLabel repeats under every point, keep it to one or two words.

chart.alertLine is null when there's no second series, that line is skipped rather than
drawn flat.
#}
{% macro lineChart(title, chart, countLabel, alertLabel, alertShortLabel) %}
  {% set countLabel = countLabel or "Number of Re-Entries" %}
  {% set alertLabel = alertLabel or "Alerts Issued" %}
  {% set alertShortLabel = alertShortLabel or "alerts" %}
  <div class="msh-line-chart">
    <div class="msh-line-chart__legend">
      <span class="msh-line-chart__legend-item msh-line-chart__legend-item--count">{{ countLabel }} (scale 0 to {{ chart.countMax }})</span>
      {% if chart.alertLine %}
        <span class="msh-line-chart__legend-item msh-line-chart__legend-item--alerts">{{ alertLabel }} (scale 0 to {{ chart.alertLine.maxValue }})</span>
      {% endif %}
    </div>
    <svg viewBox="0 0 {{ chart.width }} {{ chart.height }}" preserveAspectRatio="none" class="msh-line-chart__svg" role="img" aria-label="{{ title }}. See the labels below for exact values">
      <path d="{{ chart.countLine.path }}" class="msh-line-chart__line msh-line-chart__line--count"></path>
      {% if chart.alertLine %}
        <path d="{{ chart.alertLine.path }}" class="msh-line-chart__line msh-line-chart__line--alerts"></path>
      {% endif %}
      {% for point in chart.countLine.points %}
        <circle cx="{{ point.x }}" cy="{{ point.y }}" r="3" class="msh-line-chart__point msh-line-chart__point--count">
          <title>{{ point.label }}: {{ point.value }} ({{ countLabel }})</title>
        </circle>
      {% endfor %}
      {% if chart.alertLine %}
        {% for point in chart.alertLine.points %}
          <circle cx="{{ point.x }}" cy="{{ point.y }}" r="3" class="msh-line-chart__point msh-line-chart__point--alerts">
            <title>{{ point.label }}: {{ point.value }} ({{ alertLabel }})</title>
          </circle>
        {% endfor %}
      {% endif %}
    </svg>
    <div class="msh-line-chart__labels">
      {% for point in chart.countLine.points %}
        <div class="msh-line-chart__label-item">
          <span class="msh-line-chart__label-month">{{ point.label }}</span>
          <span class="msh-line-chart__label-value">{{ point.value }}</span>
          {% if chart.alertLine %}
            <span class="msh-line-chart__label-sub">{{ chart.alertLine.points[loop.index0].value }} {{ alertShortLabel }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endmacro %}
