{% from "govuk/components/tag/macro.njk" import govukTag %}

{% macro mshBadge(status) %}
  {% if status == "live" %}
    {{ govukTag({ text: "Live from MSH API", classes: "govuk-tag--green" }) }}
  {% elif status == "unavailable" %}
    {{ govukTag({ text: "No data available", classes: "govuk-tag--red" }) }}
  {% else %}
    {{ govukTag({ text: "No live data source connected", classes: "govuk-tag--grey" }) }}
  {% endif %}
{% endmacro %}
