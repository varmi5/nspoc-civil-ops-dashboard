{#
Renders a monthly trend as a horizontally-scrolling strip of cards instead of a long
vertical table. `months` is { month, count, alertCount? }, the sub-line only shows when
alertCount is provided (Re-Entry's trend has one, Collision & Fragmentation's doesn't).
#}
{% macro monthStrip(months) %}
  <div class="msh-month-strip">
    {% for month in months %}
      <div class="msh-month-strip__card">
        <span class="msh-month-strip__label">{{ month.month }}</span>
        <span class="msh-month-strip__value">{{ month.count }}</span>
        {% if month.alertCount is defined %}
          <span class="msh-month-strip__sub">{{ month.alertCount }} alert{{ "s" if month.alertCount != 1 }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endmacro %}
