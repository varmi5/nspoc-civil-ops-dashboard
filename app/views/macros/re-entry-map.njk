{#
Mapbox GL map, markers plotted client-side by assets/javascripts/re-entry-map.js from
the JSON data island below. `mapData` comes from buildReEntryMapViewModel or
buildReEntryViewModel.

`variant` is "full" (default, dedicated Re-Entry Map page, 3D globe) or "embedded"
(inline on the Re-Entry page, flat Mercator so it's screenshottable for reports, see
_map.scss). `idPrefix` gives each call its own container id in case a page embeds
more than one.
#}
{% macro reEntryMap(mapData, variant, idPrefix) %}
  <div class="msh-map" data-msh-map>
    {% if mapData.mapboxAccessToken %}
      <div
        id="{{ idPrefix or 'msh-mapbox-map' }}"
        class="msh-map__mapbox{{ ' msh-map__mapbox--embedded' if variant == 'embedded' }}"
        data-msh-mapbox-map
        data-msh-map-projection="{{ 'mercator' if variant == 'embedded' else 'globe' }}"
      ></div>
      <script type="application/json" data-msh-mapbox-data>{{ mapData.mapboxData | safe }}</script>
    {% else %}
      <div class="govuk-inset-text">
        Map not available — no <code>MAPBOX_ACCESS_TOKEN</code> has been configured for this environment.
      </div>
    {% endif %}
  </div>
{% endmacro %}
