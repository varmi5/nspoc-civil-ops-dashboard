{#
Real Mapbox GL JS world map. Markers are plotted client-side by assets/javascripts/
re-entry-map.js, which reads the JSON data island below (marker lat/lon/risk/etc. and
the Mapbox access token) and boots the map into [data-msh-mapbox-map]. `mapData` is the
object returned by buildReEntryMapViewModel or buildReEntryViewModel's own `mapData`.
`variant` is "full" (default, the dedicated Re-Entry Map page — Mapbox's 3D globe view)
or "embedded" (a shorter map inline on the Re-Entry page itself, forced to a flat
Mercator projection so it's screenshottable straight into a report, matching NSpOC's own
flat map slide — see _map.scss for the height difference). Each call gets its own
container id (idPrefix) since a page could embed more than one.
#}
{% macro reEntryMap(mapData, variant, idPrefix) %}
  <div class="msh-map" data-msh-map>
    {% if mapData.mapboxAccessToken %}
      <div
        id="{{ idPrefix or 'msh-mapbox-map' }}"
        class="msh-map__mapbox{{ ' msh-map__mapbox--embedded' if variant == 'embedded' }}"
        data-msh-mapbox-map
        data-msh-map-projection="{{ 'mercator' if variant == 'embedded' else 'globe' }}"
      ></div>
      <script type="application/json" data-msh-mapbox-data>{{ mapData.mapboxData | safe }}</script>
    {% else %}
      <div class="govuk-inset-text">
        Map not available — no <code>MAPBOX_ACCESS_TOKEN</code> has been configured for this environment.
      </div>
    {% endif %}
  </div>
{% endmacro %}
