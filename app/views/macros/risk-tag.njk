{% from "govuk/components/tag/macro.njk" import govukTag %}

{#
Confirmed via the reentry/conjunction/fragmentation report schemas: Risk is a six-value
enum — None, Very low, Low, Medium, High, Pending. "Pending" and null both mean "not yet
assessed" and get the same honest grey "Pending analysis" tag, rather than guessing.
#}
{% macro riskTag(risk) %}
  {% if risk == "High" or risk == "Critical" %}
    {{ govukTag({ text: risk, classes: "govuk-tag--red" }) }}
  {% elif risk == "Medium" %}
    {{ govukTag({ text: risk, classes: "govuk-tag--yellow" }) }}
  {% elif risk == "Low" or risk == "Very low" %}
    {{ govukTag({ text: risk, classes: "govuk-tag--green" }) }}
  {% elif risk == "None" %}
    {{ govukTag({ text: risk, classes: "govuk-tag--blue" }) }}
  {% elif risk == "Pending" or not risk %}
    {{ govukTag({ text: "Pending analysis", classes: "govuk-tag--grey" }) }}
  {% else %}
    {{ govukTag({ text: risk, classes: "govuk-tag--grey" }) }}
  {% endif %}
{% endmacro %}
