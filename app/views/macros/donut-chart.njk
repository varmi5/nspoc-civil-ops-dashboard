{#
Renders the object from app/lib/charts/donut.js as an SVG donut with a legend. The legend
is the real text alternative for screen readers and print, colour is just decoration.

`status` ("live"|"unavailable"|"not-connected", optional): shows "N/A" instead of an
empty circle when there's no source or the fetch failed. A badge elsewhere on the page
already explains why, so this doesn't repeat it. If the source is live but there's
simply no data for the period, this is the only place saying so.
#}
{% macro donutChart(title, chart, status) %}
  <div class="msh-donut-chart">
    <figure class="msh-donut-chart__figure">
      {% if chart.total > 0 %}
        <svg width="120" height="120" viewBox="0 0 36 36" role="img" aria-label="{{ title }}. See the list below for exact values">
          <circle cx="18" cy="18" r="{{ chart.radius }}" fill="none" stroke-width="3.8" class="msh-donut-chart__track"></circle>
          {% for segment in chart.segments %}
            <circle
              cx="18" cy="18" r="{{ chart.radius }}" fill="none" stroke-width="3.8"
              class="msh-donut-chart__segment msh-donut-chart__segment--{{ segment.colourIndex }}"
              stroke-dasharray="{{ segment.dashArray }}"
              stroke-dashoffset="{{ segment.dashOffset }}"
              transform="rotate(-90 18 18)"
            ></circle>
          {% endfor %}
        </svg>
      {% elif status == "not-connected" or status == "unavailable" %}
        <p class="msh-donut-chart__empty">N/A</p>
      {% else %}
        <p class="msh-donut-chart__empty">No data available this reporting period</p>
      {% endif %}
    </figure>
    <div>
      <p class="msh-donut-chart__title">{{ title }}</p>
      {% if chart.total > 0 %}
        <ul class="msh-donut-chart__legend">
          {% for segment in chart.segments %}
            <li class="msh-donut-chart__legend-item">
              <span class="msh-donut-chart__swatch msh-donut-chart__swatch--{{ segment.colourIndex }}"></span>
              <span>{{ segment.label }}: {{ segment.value }} ({{ segment.percent }}%)</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endmacro %}
