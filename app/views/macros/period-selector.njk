{#
Row of plain links, each reloads the page with a new query param value, no JS needed,
bookmarkable. The active option gets aria-current="true" plus a highlighted style.
`extraQuery` (optional) carries over other query params, needed when a page has a
second independent selector (e.g. Collision & Fragmentation's month picker), so
changing this period doesn't reset it.
#}
{% macro periodSelector(basePath, currentValue, options, paramName, unitLabel, extraQuery) %}
  <div class="msh-period-selector" role="group" aria-label="Choose time period">
    {% for option in options %}
      {% set isCurrent = option == currentValue %}
      <a
        class="msh-period-selector__link{{ ' msh-period-selector__link--current' if isCurrent }}"
        href="{{ basePath }}?{{ paramName }}={{ option }}{% for name, value in extraQuery %}&{{ name }}={{ value }}{% endfor %}"
        {%- if isCurrent %} aria-current="true"{% endif %}
      >{{ option }} {{ unitLabel }}{{ "s" if option != 1 }}</a>
    {% endfor %}
  </div>
{% endmacro %}
