{% from "macros/month-strip.njk" import monthStrip %}
{% from "macros/bar-chart.njk" import barChart %}
{% from "macros/line-chart.njk" import lineChart %}

{#
Wraps the month-strip card view with a toggleable graph view. Cards are the default and
the only thing that renders with no JS, the toggle buttons stay hidden until JS
confirms it can wire them up (same pattern as print-link.njk). `idPrefix` must be
unique per call when a page has more than one trend view (e.g. Collision &
Fragmentation has two). `chart` comes from app/lib/charts/bar-chart.js or
line-chart.js, built in the view-model. `chartType` picks which, "bar" (default) or
"line".
#}
{% macro trendView(idPrefix, title, months, chart, chartType) %}
  <div class="msh-trend-view" data-msh-trend-view>
    <div class="msh-trend-view__toggle msh-trend-view__toggle--hidden" role="group" aria-label="{{ title }}: choose view">
      <button type="button" class="msh-trend-view__toggle-btn" data-view="cards" aria-pressed="true" aria-controls="{{ idPrefix }}-cards">Card view</button>
      <button type="button" class="msh-trend-view__toggle-btn" data-view="graph" aria-pressed="false" aria-controls="{{ idPrefix }}-graph">Graph view</button>
    </div>
    <div id="{{ idPrefix }}-cards" data-msh-trend-panel="cards">
      {{ monthStrip(months) }}
    </div>
    <div id="{{ idPrefix }}-graph" data-msh-trend-panel="graph" hidden>
      {% if chartType == "line" %}
        {{ lineChart(title, chart) }}
      {% else %}
        {{ barChart(title, chart) }}
      {% endif %}
    </div>
  </div>
{% endmacro %}
