{% from "macros/badge.njk" import mshBadge %}

{#
Renders one KPI tile. `params`:
  label       (string, required)
  value       (string|number, required unless status is not "live")
  unit        (string, optional)
  delta       (string, optional) — e.g. "- 20 (29%)"
  deltaGood   (boolean, optional) — true renders green/up, false renders red/down,
              omitted renders neutral grey. Decided by the caller, since "up" isn't
              always good (e.g. more high-risk collision alerts is bad; more UK objects
              in orbit is neutral/expected growth).
  href        (string, optional) — wraps the tile in a link when present
  status      ("live"|"unavailable"|"not-connected", optional) — when passed, renders
              the badge inside the tile, and when not "live", shows "N/A" in place of
              `value`/`delta` rather than a number that could be mistaken for real data.
              The badge below is the one place that explains why — the value itself
              doesn't repeat that explanation, so it isn't shown twice on the same tile.
  caveat      (string, optional) — a short, always-visible warning shown under the
              value even when status is "live", for a figure that's real but knowingly
              a different metric to what it might be compared against (e.g. the
              conjunction-events count vs NSpOC's own reported figure). Plain text only
              — the tile itself may already be a link, so this must never contain one.
#}
{% macro kpiTile(params) %}
  {% set deltaClass = "msh-kpi-tile__delta--neutral" %}
  {% if params.deltaGood == true %}{% set deltaClass = "msh-kpi-tile__delta--up" %}{% endif %}
  {% if params.deltaGood == false %}{% set deltaClass = "msh-kpi-tile__delta--down" %}{% endif %}

  {% if params.href %}
    <a class="msh-kpi-tile" href="{{ params.href }}">
  {% else %}
    <div class="msh-kpi-tile">
  {% endif %}
      {% if params.status == "unavailable" or params.status == "not-connected" %}
        <span class="msh-kpi-tile__value msh-kpi-tile__value--empty">N/A</span>
      {% else %}
        <span class="msh-kpi-tile__value">{{ params.value }}{% if params.unit %} {{ params.unit }}{% endif %}</span>
      {% endif %}
      <span class="msh-kpi-tile__label">{{ params.label }}</span>
      {% if params.delta and params.status == "live" %}
        <span class="msh-kpi-tile__delta {{ deltaClass }}">{{ params.delta }}</span>
      {% endif %}
      {% if params.caveat and params.status == "live" %}
        <span class="msh-kpi-tile__caveat">{{ params.caveat }}</span>
      {% endif %}
      {% if params.status != undefined %}
        <span class="msh-kpi-tile__badge">{{ mshBadge(params.status) }}</span>
      {% endif %}
  {% if params.href %}
    </a>
  {% else %}
    </div>
  {% endif %}
{% endmacro %}
