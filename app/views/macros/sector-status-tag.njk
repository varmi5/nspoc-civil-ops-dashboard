{% from "govuk/components/tag/macro.njk" import govukTag %}

{#
Same shape as riskTag in risk-tag.njk, but for Green/Yellow/Red sector status. See
sector-rules.js for how it's derived, flagged there as a first draft, not yet signed
off by NSpOC.
#}
{% macro sectorStatusTag(status) %}
  {% if status == "Red" %}
    {{ govukTag({ text: "Red", classes: "govuk-tag--red" }) }}
  {% elif status == "Yellow" %}
    {{ govukTag({ text: "Yellow", classes: "govuk-tag--yellow" }) }}
  {% else %}
    {{ govukTag({ text: "Green", classes: "govuk-tag--green" }) }}
  {% endif %}
{% endmacro %}
