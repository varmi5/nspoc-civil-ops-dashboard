{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{#
GET form with a native month <select>. The "View" button works with no JS,
application.js progressively enhances the select to auto-submit on change. `extraQuery`
(optional) preserves other query params as hidden fields, needed when a page has a
second independent selector (e.g. Collision & Fragmentation's lookback), so picking a
month doesn't reset it.
#}
{% macro monthSelector(basePath, currentValue, options, extraQuery) %}
  <form method="get" action="{{ basePath }}" class="msh-month-selector">
    {% for name, value in extraQuery %}
      <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endfor %}
    {{ govukSelect({
      id: "month",
      name: "month",
      label: { text: "Reporting month" },
      items: options,
      value: currentValue,
      classes: "js-month-selector"
    }) }}
    {{ govukButton({ text: "View", classes: "msh-month-selector__submit" }) }}
  </form>
{% endmacro %}
